# App (read by Expo). Copy this file to .env.local and fill in the address of your Convex deployment.
# Teammates: ask for the shared development address; it is not kept in the repository.
EXPO_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Backend secrets are NOT kept in files. Set them on the Convex deployment:
#   npx convex env set ANTHROPIC_API_KEY sk-ant-...
#   npx convex env set READER_MODEL claude-opus-5-5
#   npx convex env set TAG_MODEL claude-haiku-5-5        (optional: faster model for tagging dishes)
#   npx convex env set EXPLAIN_MODEL claude-sonnet-5-5   (optional: model for ranking lines and explanations)
#   npx convex env set CHECK_MODEL ...                   (optional: model for the per-rule safety check; defaults to READER_MODEL)
#   npx convex env set TYPESAFE_API_KEY ...              (optional: fast provisional verdicts from the Jev judge, and the benchmark)
#   npx convex env set TRANSCRIBE_MODEL ...              (optional: model that reads the photo; defaults to READER_MODEL)
#   npx convex env set JUDGE_ENABLED true                (optional: also let the judge influence FINAL verdicts; off by default, see bench/reports/)
#   npx convex env set SCAN_CACHE off                    (optional: stop reusing answers to identical tagging requests and barcode lookups)

# Together (Whop communities and friend challenges)
#   EXPO_PUBLIC_TOGETHER_LIVE=1                         (app: use the shared backend's Together functions; set after
#                                                         deploying convex/members.ts and convex/together.ts)
#   EXPO_PUBLIC_WHOP_CLIENT_ID=app_...                  (optional: the Whop OAuth app; defaults to Fit's)
#   npx convex env set MONEY_CHALLENGES on              (later: allow paid challenges once Whop checkout is wired)
